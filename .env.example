# Local secrets. Never commit .env; .env.example documents the names.
# TypeSafe AI (Jev decision model), https://docs.typesafe.ai
TYPESAFE_API_KEY=
# OpenAI (LLM roles)
OPENAI_API_KEY=
# ElevenLabs (voice: text-to-speech and speech-to-text), https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional voice overrides: the low-latency multilingual model, the Scribe
# model and the voice id (default: the account's first Turkish voice, else the
# premade Sarah voice). Leave blank to accept the defaults.
ELEVENLABS_TTS_MODEL=
ELEVENLABS_STT_MODEL=
ELEVENLABS_VOICE_ID=
