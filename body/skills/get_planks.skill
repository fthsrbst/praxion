# Turn logs into planks. One log yields four planks (26.3 recipe data).
# Leaf skill: the pickaxe's children must stay leaves so that the chain
# get_stone_pickaxe -> get_cobblestone -> get_wooden_pickaxe -> leaf fits the
# core depth of 4. It therefore mines its own logs instead of calling get_wood.
skill get_planks(n: int = 4)
  doc "Craft at least n oak planks."
  rules:
    count(oak_planks) >= $n -> done
    count(oak_log) >= 1 -> craft(oak_planks)
    true -> mine(oak_log)
