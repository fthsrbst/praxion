# A wooden pickaxe needs 3 planks and 2 sticks, and a placed crafting table.
# Picks are 3x3 recipes, so the table is placed before the pickaxe is crafted.
# Its three children are leaf skills, so the whole first-night chain stays
# within the core depth of 4.
skill get_wooden_pickaxe()
  doc "Have a wooden pickaxe, with a crafting table placed nearby."
  rules:
    count(wooden_pickaxe) >= 1 -> done
    count(oak_planks) >= 3 and count(stick) >= 2 and near(crafting_table, 4) -> craft(wooden_pickaxe)
    count(stick) < 2 -> do get_sticks(2)
    count(oak_planks) < 3 -> do get_planks(3)
    true -> do get_crafting_table_near()
