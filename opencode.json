{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "git push *": "deny",
      "git commit *": "deny",
      "git reset *": "deny",
      "git checkout *": "deny",
      "git rebase *": "deny",
      "git * push *": "deny",
      "git * commit *": "deny",
      "git * reset *": "deny",
      "git * checkout *": "deny",
      "git * rebase *": "deny",
      "rm -rf *": "deny"
    },
    "external_directory": {
      "*": "deny",
      "~/.config/opencode/*": "allow",
      "~/.claude/skills/*": "allow",
      "~/.agents/skills/*": "allow"
    }
  }
}
