+/// An item stack in its network template form: an item, a count and a data
+/// component patch.
+///
+/// This is the same payload as `ItemStackTemplate.STREAM_CODEC` in vanilla:
+/// the item registry id comes first, then a VarInt count, then the patch.
+/// Unlike [`ItemStack`] the item cannot be missing (air is rejected by the
+/// vanilla constructor), so no count-zero emptiness marker is sent.
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct ItemStackTemplate {
+    #[serde(rename = "id")]
+    pub kind: ItemKind,
+    pub count: i32,
+    #[serde(rename = "components", skip_serializing_if = "is_default")]
+    pub component_patch: DataComponentPatch,
+}
+
+impl ItemStackTemplate {
+    /// Create a new [`ItemStackTemplate`] with the given number of
+    /// [`ItemKind`]s.
+    pub fn new(item: ItemKind, count: i32) -> Self {
+        ItemStackTemplate {
+            kind: item,
+            count,
+            component_patch: Default::default(),
+        }
+    }
+}
+
+impl AzBuf for ItemStackTemplate {
+    fn azalea_read(buf: &mut Cursor<&[u8]>) -> Result<Self, BufReadError> {
+        let kind = ItemKind::azalea_read(buf)?;
+        let count = i32::azalea_read_var(buf)?;
+        let component_patch = DataComponentPatch::azalea_read(buf)?;
+        Ok(ItemStackTemplate {
+            kind,
+            count,
+            component_patch,
+        })
+    }
+    fn azalea_write(&self, buf: &mut impl Write) -> io::Result<()> {
+        self.kind.azalea_write(buf)?;
+        self.count.azalea_write_var(buf)?;
+        self.component_patch.azalea_write(buf)
+    }
+}
+
+impl From<(ItemKind, i32)> for ItemStackTemplate {
+    fn from(item: (ItemKind, i32)) -> Self {
+        ItemStackTemplate::new(item.0, item.1)
+    }
+}
